# QuMail configuration — copy to .env and edit.  NEVER commit .env (it is git-ignored).
# Every variable is optional; the defaults shown here are used when a line is missing.
# The e-mail PASSWORD is never stored here — it is typed in the login screen only.

# --- login screen defaults ---------------------------------------------------
QUMAIL_EMAIL=you@gmail.com
QUMAIL_PROVIDER=Gmail              # Gmail | Yahoo

# --- Key Manager -------------------------------------------------------------
QUMAIL_KM_URL=http://localhost:5000
QUMAIL_KM_TIMEOUT=5                # seconds

# --- mail transport ----------------------------------------------------------
QUMAIL_SMTP_PORT=465
QUMAIL_SMTP_TIMEOUT=30             # raise to 180 if an antivirus mail shield slows uploads
QUMAIL_IMAP_TIMEOUT=30

# --- attachment limits -------------------------------------------------------
QUMAIL_MAX_FILES=10
QUMAIL_MAX_FILE_MB=15
QUMAIL_MAX_TOTAL_MB=18             # ~25 MB after base64 (Gmail/Yahoo limit)
QUMAIL_LEVEL3_WARN_KB=50           # warn before OTP on files bigger than this

# --- address book ------------------------------------------------------------
QUMAIL_CONTACTS_FILE=~/.qumail/contacts.json   # contacts + key-exchange info (never in the repo)
